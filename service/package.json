{
  "name": "bug-triage-service",
  "version": "0.1.0",
  "private": true,
  "description": "Bug Report Triage Service (NestJS/TypeScript)",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "ts-node-dev --respawn --exit-child --transpile-only src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:prisma": "prisma format --schema prisma/schema.prisma",
    "format:prisma:check": "bash scripts/check-prisma-format.sh",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "seed:set-a": "ts-node src/scripts/seed-set-a.ts",
    "tune:duplicate-floor": "ts-node src/scripts/tune-duplicate-floor.ts",
    "verify:duplicate-thresholds": "ts-node src/eval/duplicate-threshold-regression.ts",
    "eval:set-b": "ts-node src/eval/eval-set-b.ts",
    "eval:set-c": "ts-node src/eval/eval-set-c.ts",
    "eval:set-d": "ts-node src/eval/eval-set-d.ts",
    "eval": "npm run verify:duplicate-thresholds && npm run eval:set-b && npm run eval:set-c",
    "test:mutation": "stryker run",
    "preflight": "npm run typecheck && npm run lint && npm run format:check && npm run format:prisma:check && npm run test:coverage && npm run eval && npm run test:mutation"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@huggingface/transformers": "^4.2.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^standardwebhooks$": "<rootDir>/../test/mocks/standardwebhooks.js"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!eval/**",
      "!scripts/**",
      "!**/*.module.ts",
      "!main.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 80
      }
    }
  }
}
