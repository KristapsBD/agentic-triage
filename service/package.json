{
  "name": "bug-triage-service",
  "version": "0.1.0",
  "private": true,
  "description": "Bug Report Triage Service (NestJS/TypeScript rebuild — issue #26)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "ts-node-dev --respawn --exit-child --transpile-only src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed:set-a": "ts-node src/scripts/seed-set-a.ts",
    "tune:duplicate-floor": "ts-node src/scripts/tune-duplicate-floor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@huggingface/transformers": "^4.2.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^standardwebhooks$": "<rootDir>/../test/mocks/standardwebhooks.js"
    },
    "testEnvironment": "node"
  }
}
