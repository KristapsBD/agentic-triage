# GITEA_REPO_NAME is the triage SERVICE's target repo — the fictional
# product it files/checks bug reports against. This is deliberately a
# separate Gitea project from "bug-triage" (this codebase's own Gitea
# project + planning tickets), created by ./bootstrap.sh, so the service's
# own build/planning tickets can never leak into its duplicate-detection
# candidate pool. See README.md.
GITEA_URL=http://localhost:3000
GITEA_REPO_OWNER=triageadmin
GITEA_REPO_NAME=acme-app
GITEA_TOKEN=

ANTHROPIC_API_KEY=

# Postgres/Prisma (issue #58). Not yet consumed by application code — see
# service/prisma/schema.prisma. The host-facing form below matches the
# `postgres` docker-compose service's published port; when triage-service
# itself runs inside compose, DATABASE_URL is overridden to the in-network
# host (see docker-compose.yml).
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage?schema=public
